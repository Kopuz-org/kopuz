  "query": "SELECT a.source_album_id, a.title, a.artist, a.genre, a.year, a.cover_path, a.manual_cover, a.artist_id FROM albums a JOIN tracks t ON t.source = a.source AND t.source_album_id = a.source_album_id WHERE a.source = ?1 GROUP BY a.rowid_pk ORDER BY MAX(t.added_at) DESC, MAX(t.rowid_pk) DESC LIMIT ?2",
