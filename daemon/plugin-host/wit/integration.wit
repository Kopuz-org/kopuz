/// A plugin that adds something to kopuz other than a source: a device that
/// follows the music, a service told what plays, a smarter mix. The host opens
/// it once the person has filled in its fields and keeps one instance of it
/// running until they clear them, so a connection it holds stays open.
interface integration {
    use types.{source-error};

    /// One answered field of the manifest's `[[integration.field]]` list. A
    /// toggle is `"true"` or `"false"`.
    record setting {
        key: string,
        value: string,
    }

    /// The track playing, as the library knows it.
    record now-playing {
        /// The library's key for it, the same across restarts.
        key: string,
        title: string,
        artist: string,
        album: string,
        duration-ms: option<u64>,
        musicbrainz-recording-id: option<string>,
        musicbrainz-release-id: option<string>,
    }

    record started {
        track: now-playing,
        /// Where in it playback began, in milliseconds.
        position-ms: u64,
    }

    /// What playback just did. Positions are milliseconds into the track.
    variant playback-event {
        /// A track began playing, from its start or wherever it was resumed.
        started(started),
        paused(u64),
        resumed(u64),
        /// The person moved within the track that is playing.
        seeked(u64),
        /// Nothing plays any more.
        stopped,
    }

    /// What the music sounds like over the last twentieth of a second (50 ms),
    /// measured before the volume, so turning it down does not quiet it. Each
    /// level is an RMS from 0 (silence) towards 1 (full scale).
    record audio-frame {
        level: f32,
        /// The largest sample, from 0 to 1.
        peak: f32,
        /// Below about 200 Hz: kick drums and bass.
        low: f32,
        mid: f32,
        /// Above about 2 kHz: cymbals and hi-hats.
        high: f32,
        /// How much louder this frame got than the ones before it, from 0;
        /// a drum hit is high, a held note is near 0.
        onset: f32,
        /// An onset well above the recent ones, at least a quarter second
        /// after the last: a likely beat.
        beat: bool,
    }

    /// What an action was run on.
    variant action-target {
        /// Nothing: it was run from the command palette.
        none,
        /// Library track keys, from a track's menu or a selection.
        tracks(list<string>),
        /// An album id, from an album's menu.
        album(string),
        /// An artist's library key, from an artist's menu.
        artist(string),
    }

    /// What a panel is drawn for.
    variant panel-target {
        album(string),
        /// An artist's library key.
        artist(string),
        /// The library key of the track playing, for a tab beside the queue.
        track(string),
    }

    /// One piece of a panel, drawn by the app in its own style.
    variant block {
        heading(string),
        text(string),
        /// Library track keys, drawn as rows that play from where they are clicked.
        tracks(list<string>),
        /// A button that runs one of the manifest's actions on what the panel is for.
        action(panel-action),
    }

    record panel-action {
        label: string,
        /// The id of one of the manifest's `[[integration.action]]` entries.
        action: string,
    }

    /// A track kopuz asks a plugin about.
    record song {
        key: string,
        title: string,
        artist: string,
        album: string,
        duration-ms: option<u64>,
    }

    /// Where a transition's three equalizer bands sit.
    record bands {
        high-hz: f32,
        mid-hz: f32,
        mid-q: f32,
        bass-hz: f32,
    }

    /// One deck through a transition, each curve sampled every `step`
    /// seconds from its start, all of one length; past its last sample a
    /// curve holds that value.
    record deck-curves {
        /// Linear gain, 1 for as recorded.
        volume: list<f32>,
        /// Playback rate, 1 for as recorded.
        speed: list<f32>,
        /// Each band's cut or boost in dB, 0 for flat.
        high-db: list<f32>,
        mid-db: list<f32>,
        bass-db: list<f32>,
        /// A high-pass corner in Hz, for a deck that brings its bass in late.
        highpass-hz: option<list<f32>>,
    }

    /// How to go from one track into the next, in seconds.
    record transition-plan {
        /// Into the outgoing track, where the transition begins.
        start: f64,
        length: f64,
        /// Into the incoming track, where it starts playing.
        entry: f64,
        /// Between curve samples; above 0.
        step: f64,
        bands: bands,
        outgoing: deck-curves,
        incoming: deck-curves,
    }

    /// Lyrics a plugin found.
    variant found-lyrics {
        /// Words with no timing.
        plain(string),
        /// LRC: `[mm:ss.xx]` before each line, and `<mm:ss.xx>` before each
        /// word for word timing.
        lrc(string),
    }

    resource instance {
        constructor(settings: list<setting>);

        /// Whether the settings work, asked when they are saved; an error
        /// keeps them from being kept.
        validate: func() -> result<_, source-error>;

        /// Asked only of an integration whose manifest listens to
        /// `playback`, in the order things happened.
        on-playback: func(event: playback-event);

        /// Asked only of an integration whose manifest listens to `audio`,
        /// about twenty times a second while music plays, with the frames
        /// since the last call. One that falls behind misses frames rather
        /// than hearing them late.
        on-audio: func(frames: list<audio-frame>);

        /// Asked only of an integration whose manifest listens to `tick`,
        /// every `tick-ms`, so one can look for what it waits on, such as a
        /// button pressed on a remote. A tick still running when the next is
        /// due makes that one skip.
        on-tick: func();

        /// One of the manifest's `[[integration.action]]` entries, chosen by
        /// the person. `input` is what they typed when the action has an
        /// `ask`. An answer is shown to them as a notice; an error as a failure.
        run-action: func(id: string, target: action-target, input: option<string>) -> result<option<string>, string>;

        /// One of the manifest's `[[integration.panel]]` entries, for the
        /// album or artist page it is drawn on. Nothing to show is an empty list.
        render-panel: func(id: string, target: panel-target) -> result<list<block>, string>;

        /// Asked only of an integration whose manifest provides `lyrics`, for
        /// a track none of kopuz's own lyric sources has words for. Nothing
        /// found is `none`.
        lyrics: func(track: song) -> result<option<found-lyrics>, string>;

        /// Asked only of an integration whose manifest provides `radio`, when
        /// the queue runs out with autoplay on: library track keys to play
        /// after `seed`, the track that just finished. `recent` holds the keys
        /// of the queue so far, newest last, so it can leave them out. An
        /// empty list lets kopuz's own radio go on instead.
        radio: func(seed: song, recent: list<string>) -> result<list<string>, string>;

        /// Asked only of an integration whose manifest provides
        /// `transitions`, once the track after `outgoing` is known: how to go
        /// into `incoming`. Nothing is `none`, and kopuz's own crossfade plays.
        transition: func(outgoing: song, incoming: song) -> result<option<transition-plan>, string>;
    }
}
