interface types {
    variant source-error {
        /// The host falls back to its own behavior where it has one.
        unsupported(string),
        connectivity,
        auth,
        invalid-input(string),
        backend(string),
    }

    enum auth-outcome {
        valid,
        expired,
        unreachable,
    }

    record connection {
        /// Which of the manifest's services the session is for.
        service: string,
        url: string,
        token: string,
        user-id: string,
        device-id: string,
        account: option<string>,
        folders: list<string>,
    }

    record auth-session {
        access-token: string,
        user-id: string,
    }

    record artist-credit {
        name: string,
        id: option<string>,
    }

    record replay-gain {
        track-gain-db: option<f32>,
        track-peak: option<f32>,
        album-gain-db: option<f32>,
        album-peak: option<f32>,
    }

    record track {
        item-id: string,
        /// In the host's stored form; see the SDK's `cover` helpers.
        cover: option<string>,
        album-id: string,
        title: string,
        artist: string,
        album: string,
        duration-secs: u64,
        sample-rate: u32,
        bitrate-kbps: u32,
        track-number: option<u32>,
        disc-number: option<u32>,
        musicbrainz-release-id: option<string>,
        musicbrainz-recording-id: option<string>,
        musicbrainz-track-id: option<string>,
        playlist-item-id: option<string>,
        artists: list<string>,
        credits: list<artist-credit>,
        replay-gain: replay-gain,
        explicit: bool,
    }

    record album {
        id: string,
        title: string,
        artist: string,
        genre: string,
        year: u16,
        cover: option<string>,
        artist-id: option<string>,
    }

    record artist-listing {
        credit: artist-credit,
        photo: option<string>,
    }

    record library-snapshot {
        albums: list<album>,
        tracks: list<track>,
        artists: list<artist-listing>,
    }

    record search-results {
        tracks: list<track>,
        albums: list<album>,
    }

    record playlist-meta {
        id: string,
        name: string,
        image-tag: option<string>,
    }

    record playlist-entry {
        key: string,
        playlist-item-id: option<string>,
    }

    record track-page {
        tracks: list<track>,
        next: option<string>,
    }

    record remote-play-queue {
        tracks: list<track>,
        current-id: option<string>,
        position-ms: u64,
        changed-by: option<string>,
    }

    enum stream-quality {
        low,
        normal,
        high,
    }

    record stream-info {
        url: string,
        /// An HLS playlist of fMP4 AAC segments rather than a file.
        hls: bool,
        user-agent: option<string>,
        duration-secs: option<u64>,
        bitrate: option<u32>,
        content-length: option<u64>,
        loudness-db: option<f32>,
    }

    record storage-quota {
        used-bytes: u64,
        quota-bytes: u64,
        remaining-bytes: u64,
    }

    enum check-step {
        reach,
        session,
        signed-in-playback,
        anonymous-playback,
        playback-token,
    }

    enum check-outcome {
        passed,
        failed,
        skipped,
    }

    record check {
        step: check-step,
        outcome: check-outcome,
        detail: string,
    }
}
